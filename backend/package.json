{
  "name": "catalogo-pro-backend",
  "version": "1.0.0",
  "description": "Backend API para CatalogPRO - LOMHIFAR",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "psql -d $DATABASE_URL -f src/db/migrations/001_initial_schema.sql",
    "db:seed": "psql -d $DATABASE_URL -f src/db/seed.sql",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "express": "4.18.2",
    "typescript": "5.0.0",
    "dotenv": "16.0.3",
    "pg": "8.10.0",
    "jsonwebtoken": "9.0.0",
    "bcryptjs": "2.4.3",
    "pdfkit": "0.13.0",
    "axios": "1.4.0",
    "cors": "2.8.5",
    "helmet": "7.0.0",
    "express-validator": "7.0.0",
    "redis": "4.6.0",
    "winston": "3.10.0"
  },
  "devDependencies": {
    "@types/express": "4.17.17",
    "@types/node": "20.0.0",
    "@types/pg": "8.10.0",
    "ts-node": "10.9.1",
    "jest": "29.5.0",
    "@types/jest": "29.5.0",
    "ts-jest": "29.1.0",
    "eslint": "8.40.0",
    "@typescript-eslint/parser": "5.59.0",
    "@typescript-eslint/eslint-plugin": "5.59.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

{
  "name": "catalogo-pro-backend",
  "version": "1.0.0",
  "description": "Backend API para CatalogPRO - LOMHIFAR",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-sql",
    "copy-sql": "mkdir -p dist/db/migrations && cp -r src/db/migrations/*.sql dist/db/migrations/ 2>/dev/null || true",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "echo \"no tests\" && exit 0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.0.3",
    "pg": "^8.11.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "pdfkit": "^0.13.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.1",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "8.5.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.0",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
